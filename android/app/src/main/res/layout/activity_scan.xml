<?xml version="1.0" encoding="utf-8"?>
<!-- Scanning: the photo with the sheet's corners, or the page as it will be, and its tools. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/close"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/scan" />

    <FrameLayout
        android:id="@+id/scan_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#202020">

        <ImageView
            android:id="@+id/scan_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="24dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/scan_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/scan_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="#DDFFFFFF" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/scan_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/scan_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Filters (once the page is cropped). -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/scan_filters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filter_color"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filter_gray"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_gray" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filter_bw"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_bw" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Read the text (OCR) when saving the PDF. -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/scan_ocr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/scan_ocr"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scan_rotate"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/pages_rotate_right"
            android:tooltipText="@string/pages_rotate_right"
            app:icon="@drawable/ic_rotate_right" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scan_retake"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/scan_retake"
            android:tooltipText="@string/scan_retake"
            app:icon="@drawable/ic_scan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scan_delete"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/scan_delete_page"
            android:tooltipText="@string/scan_delete_page"
            app:icon="@drawable/ic_delete" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scan_add"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/scan_add"
            app:icon="@drawable/ic_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scan_next"
            style="@style/Widget.Material3.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_crop"
            app:icon="@drawable/ic_check" />
    </LinearLayout>
</LinearLayout>
