<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_back">

        <!-- Tablets: view, zoom and page controls, as on the desktop. -->
        <LinearLayout
            android:id="@+id/tools"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/layout_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/layout_continuous"
                    style="?attr/materialIconButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/view_continuous"
                    android:tooltipText="@string/view_continuous"
                    app:icon="@drawable/ic_view_continuous" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/layout_single"
                    style="?attr/materialIconButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/view_single"
                    android:tooltipText="@string/view_single"
                    app:icon="@drawable/ic_view_single" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/layout_two"
                    style="?attr/materialIconButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/view_two"
                    android:tooltipText="@string/view_two"
                    app:icon="@drawable/ic_view_two" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zoom_out"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/zoom_out"
                android:tooltipText="@string/zoom_out"
                app:icon="@drawable/ic_zoom_out" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zoom_level"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="88dp"
                android:tooltipText="@string/zoom" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zoom_in"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/zoom_in"
                android:tooltipText="@string/zoom_in"
                app:icon="@drawable/ic_zoom_in" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/page_prev"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/previous_page"
                android:tooltipText="@string/previous_page"
                app:icon="@drawable/ic_chevron_left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/page_label"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="88dp"
                android:tooltipText="@string/go_to_page" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/page_next"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/next_page"
                android:tooltipText="@string/next_page"
                app:icon="@drawable/ic_chevron_right" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:tabGravity="start"
        app:tabMode="scrollable" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Phones: page number, shown for a moment while scrolling. -->
        <TextView
            android:id="@+id/page_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_page_chip"
            android:elevation="2dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
